# The application is offline by default. No external provider is selected.
BRANDPILOT_EXECUTION_MODE=offline_test
BRANDPILOT_MODEL_PROVIDER=none
BRANDPILOT_OPENAI_PAID_ENABLED=false
BRANDPILOT_IMAGE_API_ENABLED=false
# Models are explicit runtime configuration. Leave both blank in offline_test.
BRANDPILOT_GEMINI_MODEL=
GEMINI_API_KEY=
# Optional explicit path to the prepared Hermes interpreter. Otherwise use its local PM facts.
BRANDPILOT_HERMES_PYTHON=
BRANDPILOT_OPENAI_MODEL=
BRANDPILOT_AGENT_MAX_MODEL_CALLS=12
BRANDPILOT_AGENT_MAX_INPUT_TOKENS=24000
BRANDPILOT_AGENT_MAX_OUTPUT_TOKENS=12000

# Local application database. Development credentials only.
BRANDPILOT_DATABASE_URL=postgresql+psycopg://brandpilot:brandpilot@127.0.0.1:5432/brandpilot
BRANDPILOT_STORAGE_ROOT=.runtime/storage
BRANDPILOT_JOB_LEASE_SECONDS=30
BRANDPILOT_WORKER_POLL_SECONDS=2
BRANDPILOT_LOG_LEVEL=INFO

# Generate unique values locally. The encryption key is URL-safe base64 for 32 bytes.
BRANDPILOT_APP_SECRET_KEY=
BRANDPILOT_CREDENTIAL_ENCRYPTION_KEY=
BRANDPILOT_OWNER_SETUP_TOKEN=
BRANDPILOT_SESSION_COOKIE_SECURE=true
BRANDPILOT_SESSION_TTL_SECONDS=43200
BRANDPILOT_LOGIN_WINDOW_SECONDS=300
BRANDPILOT_LOGIN_MAX_ATTEMPTS=5
BRANDPILOT_MAX_UPLOAD_BYTES=10000000
BRANDPILOT_MAX_ARCHIVE_BYTES=50000000
BRANDPILOT_MAX_IMPORT_ROWS=5000
# Required when a worker connects with the RLS-restricted application role.
BRANDPILOT_WORKSPACE_ID=

# Operator-managed Meta app configuration. Meta requires an HTTPS callback.
# For local testing, use an HTTPS tunnel to Vite's port 5173, open the UI through
# that same tunnel origin, and set SESSION_COOKIE_SECURE=true. See
# docs/SOCIAL_APP_CHECKLIST.md. Do not use http://127.0.0.1:5173 here.
BRANDPILOT_META_APP_ID=
BRANDPILOT_META_APP_SECRET=
BRANDPILOT_META_GRAPH_VERSION=
BRANDPILOT_META_CALLBACK_URL=

# Hermes is a private loopback service. Generate this value locally; never commit it.
BRANDPILOT_HERMES_URL=http://127.0.0.1:8642
BRANDPILOT_HERMES_SERVICE_KEY=

# Provider keys remain blank until the owner explicitly selects a live mode.
GOOGLE_API_KEY=
OPENAI_API_KEY=
