{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://falkrona-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://falkrona-production.up.railway.app/health/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|health(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
